<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.2.2</Version>
    <!-- CR-1 SK-06：元数据分工（修正 0.2.1 的不一致）
         - Version：NuGet 包版本，每次发版递增
         - AssemblyVersion：**保持 0.2.0.0 不动**——程序集绑定版本只在 major/minor 变化时改；
           补丁版跟着跳会破坏"同一主次版本的补丁可互换"的预期
         - FileVersion / InformationalVersion：**跟随发布版本**，便于现场/诊断时确认用的是哪个包
           （0.2.1 时这两项仍停在 0.2.0，导致包内自述版本与实际不符） -->
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.2.0</FileVersion>
    <InformationalVersion>v0.2.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PackageId>Sk150PowerSupplySDK</PackageId>
    <Authors>donkilove</Authors>
    <Description>A .NET library for controlling XY-SK / ZK-SK series buck-boost power modules (SK60/SK120/SK150) over MODBUS RTU serial.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/donkilove/Sk150PowerSupplySDK</RepositoryUrl>
    <PackageTags>modbus;modbus-rtu;power-supply;sk150;xy-sk150;bench-supply;psu;serial;instrument;iot</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sk150PowerSupply.Tests" />
  </ItemGroup>

</Project>
